// ProjectScope — database schema (SQLite for the local MVP).
//
// IMPORTANT FOR BEGINNERS:
// SQLite in Prisma does not support native `Json` columns. Structured payloads
// (evidence lists, report bodies, concept arrays, ...) are therefore stored as
// JSON *strings* and are parsed + validated with Zod at the application
// boundary. See `src/lib/json.ts` for the safe helpers and `src/lib/schema.ts`
// for the exact shapes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 no longer accepts `url` in the schema. The connection URL lives in
// `prisma.config.ts` (for the CLI) and is passed to the client through the
// better-sqlite3 driver adapter in `src/lib/db.ts`.
datasource db {
  provider = "sqlite"
}

/// One research run: the user query, the sources we were allowed to check, and
/// everything we produced from it.
model ResearchJob {
  id               String    @id @default(cuid())
  topic            String
  problemStatement String?
  domain           String?
  targetUsers      String?
  geography        String?
  resultLimit      Int       @default(20)
  /// JSON: string[] of source ids that were selected for this run.
  sources          String    @default("[]")
  /// queued | running | completed | failed | cancelled
  status           String    @default("queued")
  /// Human readable pipeline stage shown in the live research view.
  stage            String    @default("queued")
  /// True when the run used bundled sample data because credentials were missing.
  isDemo           Boolean   @default(false)
  errorMessage     String?
  /// Number of project records actually found (never an estimate).
  resultCount      Int       @default(0)
  /// JSON: SourceCheck[] — one entry per source we actually contacted.
  sourcesChecked   String    @default("[]")
  /// True when the user bookmarked this search from the "Saved research" page.
  isBookmarked     Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  completedAt      DateTime?

  events           ResearchEvent[]
  results          ResearchResult[]
  sourceReferences SourceReference[]
  experiments      ValidationExperiment[]
  report           MarketGapReport?
  concepts         ProposedConcept[]
  pitch            Pitch?
  reports          SavedReport[]
  discovery        IdeaDiscovery?
}

/// Progress events emitted during a run (also streamed to the browser over SSE).
model ResearchEvent {
  id        String   @id @default(cuid())
  jobId     String
  type      String
  stage     String
  message   String
  /// info | success | warning | error
  level     String   @default("info")
  /// JSON: arbitrary structured payload for the event.
  payload   String   @default("{}")
  createdAt DateTime @default(now())

  job ResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

/// A normalised project record, deduplicated across sources.
model Project {
  id               String   @id @default(cuid())
  title            String
  platform         String
  sourceId         String
  sourceUrl        String
  attribution      String
  summary          String
  problemAddressed String?
  proposedSolution String?
  targetUsers      String?
  /// JSON: string[]
  technologies     String   @default("[]")
  businessModel    String?
  distribution     String?
  /// Award or ranking, only populated when we could verify it from a source.
  award            String?
  awardVerified    Boolean  @default(false)
  ranking          String?
  domain           String?
  /// Cluster id assigned by the OpenAI clustering pass.
  clusterId        String?
  /// JSON: string[] — what we are NOT sure about for this record.
  uncertaintyNotes String   @default("[]")
  /// JSON: string[] — the raw search-result metadata this record came from.
  discoveryMetadata String  @default("[]")
  retrievedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  results  ResearchResult[]
  savedBy  SavedProject[]
}

/// A single retrieved source page / result that backs a project record.
model SourceReference {
  id          String   @id @default(cuid())
  jobId       String
  sourceId    String
  sourceName  String
  url         String
  title       String?
  attribution String
  /// metadata-only | fetched | manual-import | search-grounded
  accessMode  String
  snippet     String?
  retrievedAt DateTime @default(now())

  job ResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

/// Join between a research job and a discovered project.
model ResearchResult {
  id            String   @id @default(cuid())
  jobId         String
  projectId     String
  relevance     Float    @default(0)
  rank          Int      @default(0)
  discoveryNote String?
  isDemo        Boolean  @default(false)
  createdAt     DateTime @default(now())

  job     ResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([jobId, projectId])
  @@index([jobId, relevance])
}

/// Gemini-generated market gap report for a research job.
model MarketGapReport {
  id          String   @id @default(cuid())
  jobId       String   @unique
  summary     String
  /// JSON: MarketGap[]
  gaps        String   @default("[]")
  /// JSON: RepeatedPattern[]
  patterns    String   @default("[]")
  /// JSON: CompetitorProfile[]
  competitors String   @default("[]")
  /// JSON: Assumption[]
  assumptions String   @default("[]")
  /// JSON: ValidationExperiment[]
  experiments String   @default("[]")
  /// JSON: SourceLink[] — the sources that back the factual claims.
  sources     String   @default("[]")
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  job ResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

/// A differentiated concept produced by the Idea Studio.
model ProposedConcept {
  id                String   @id @default(cuid())
  jobId             String
  title             String
  tagline           String
  problem           String
  targetUsers       String
  solution          String
  /// JSON: string[]
  differentiators   String   @default("[]")
  /// JSON: ConceptComparison[]
  comparisons       String   @default("[]")
  /// JSON: string[]
  risks             String   @default("[]")
  validationPlan    String
  /// Populated when the concept overlaps heavily with an existing project.
  similarityWarning String?
  isDemo            Boolean  @default(false)
  createdAt         DateTime @default(now())

  job ResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

/// A validation experiment proposed for a market gap.
model ValidationExperiment {
  id              String   @id @default(cuid())
  jobId           String
  title           String
  hypothesis      String
  method          String
  metric          String
  successCriteria String
  duration        String?
  cost            String?
  relatedGapId    String?
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())

  job ResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

/// The pitch deck content for a research job.
model Pitch {
  id           String   @id @default(cuid())
  jobId        String   @unique
  /// JSON: PitchContent
  content      String
  clarityScore Int?
  /// JSON: string[] — reviewer notes about pitch clarity.
  clarityNotes String   @default("[]")
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  job ResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

/// A project the user bookmarked.
model SavedProject {
  id        String   @id @default(cuid())
  projectId String
  note      String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId])
}

/// An exported report the user saved.
model SavedReport {
  id        String   @id @default(cuid())
  jobId     String
  title     String
  format    String   @default("markdown")
  createdAt DateTime @default(now())

  job ResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

/// A free-choice discovery run: the user did not name a problem, so
/// ProjectScope researched open-ended sources and proposed problems itself.
model IdeaDiscovery {
  id               String   @id @default(cuid())
  /// The research job that holds the evidence this discovery was built from.
  jobId            String   @unique
  /// All optional. The user may leave every one of them blank.
  interests        String   @default("")
  techPreferences  String   @default("")
  teamCapabilities String   @default("")
  constraints      String   @default("")
  status           String   @default("queued")
  stage            String   @default("queued")
  isDemo           Boolean  @default(false)
  errorMessage     String?
  /// JSON: DiscoveryConcept[]
  concepts         String   @default("[]")
  /// JSON: DiscoveryRecommendation
  recommendation   String?
  /// JSON: DiscoveryAnalysis (patterns, weaknesses, underserved users, problems)
  analysis         String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  job       ResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  proposals Proposal[]

  @@index([createdAt])
}

/// A complete project proposal for one concept.
model Proposal {
  id          String   @id @default(cuid())
  discoveryId String
  conceptId   String
  title       String
  /// JSON: ProposalContent
  content     String
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())

  discovery IdeaDiscovery @relation(fields: [discoveryId], references: [id], onDelete: Cascade)

  @@index([discoveryId])
}
