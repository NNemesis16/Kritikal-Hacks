{
  "name": "kritikal-hacks",
  "version": "1.0.0",
  "private": true,
  "description": "ProjectScope — AI-powered hackathon project intelligence. Find the gap nobody filled.",
  "repository": {
    "type": "git",
    "url": "https://github.com/NNemesis16/Kritikal-Hacks.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:migrate:soft && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:soft": "tsx scripts/migrate.ts --soft",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@libsql/client": "^0.18.0",
    "@tiny-fish/sdk": "^0.8.0",
    "lenis": "^1.3.27",
    "next": "16.4.2",
    "openai": "^7.39.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
