# ProjectScope — environment variables
#
#   Copy-Item .env.example .env.local
#
# On Vercel you do NOT need a .env file: add these same variables in
# Project Settings → Environment Variables, then redeploy.
#
# SECURITY RULES FOR THIS PROJECT
# -------------------------------
# * These variables are read ONLY on the server. Never rename them with the
#   NEXT_PUBLIC_ prefix and never reference them in client components — that
#   would ship your keys to every browser.
# * .env.local is git-ignored. Never commit real keys.
# * Rotate a key by creating a new one in the provider dashboard, updating
#   the variable, and revoking the old key.

# ---------------------------------------------------------------------------
# TinyFish — web discovery (Search API + Fetch API)
# Create a key at: https://agent.tinyfish.ai/api-keys
# Used server-side only, sent as the `X-API-Key` header.
# Without it the app runs in demo mode.
TINYFISH_API_KEY=

# ---------------------------------------------------------------------------
# OpenAI — normalisation, clustering, idea scoring, pitch review
# Create a key at: https://platform.openai.com/api-keys
# Used server-side only, sent as `Authorization: Bearer ...`.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Gemini — market-gap synthesis, free-choice analysis
# Create a key at: https://aistudio.google.com/apikey
# Used server-side only, sent as the `x-goog-api-key` header.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Models (optional — sensible defaults are used when blank)
# OPENAI_MODEL  : any model that supports the Responses API + structured outputs.
# GEMINI_MODEL  : any Gemini model that supports the Interactions API and the
#                 `google_search` grounding tool.
OPENAI_MODEL=gpt-6.1-sol
GEMINI_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development (the default):
#   A SQLite file inside the `prisma/` folder. The file is created for you
#   by `npm run db:migrate` and is git-ignored.
DATABASE_URL=file:./dev.db

# Production (Vercel) — a hosted libSQL/Turso database:
#   1. Create a free database:  https://turso.new
#   2. Copy the "Database URL" (starts with libsql://) into DATABASE_URL
#   3. Copy the "Auth Token" into DATABASE_AUTH_TOKEN
#   4. The build runs `npm run db:migrate`, so the tables are created for you.
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=

# Only needed for a hosted database. Leave empty for a local SQLite file.
DATABASE_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Force demo mode even when keys are present ("true" / "false").
# DEMO_MODE=false
# Maximum number of results a single research run may collect (1-100).
# MAX_RESULTS_LIMIT=40
# Per-request timeout for provider calls, in milliseconds.
# PROVIDER_TIMEOUT_MS=45000
